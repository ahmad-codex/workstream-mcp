# Build output
bin/
obj/
out/
TestResults/
*.binlog
*.user
*.suo
.vs/
.vscode/
.idea/

# Local secrets and operator files (NEVER commit)
# Don't ignore the deploy/secrets/ directory itself — only its contents — so the
# README explaining what goes in there stays tracked.
secrets/
!deploy/secrets/
deploy/secrets/*
!deploy/secrets/README.md
*.pem
*.key
.workstream-admin.toml
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Claude Code per-user config and hook artifacts. Team-wide hooks (if any) go in
# .claude/settings.json which IS committed; the local override and hook scripts
# are personal.
.claude/settings.local.json
.claude/hooks/
.claude/last-rebuild.log

# Coverage
coverage/
*.coverage
*.coveragexml

# Logs
*.log
logs/
