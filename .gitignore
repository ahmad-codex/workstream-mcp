# Build output
bin/
obj/
out/
TestResults/
*.binlog
*.user
*.suo
.vs/
.vscode/
.idea/

# Local secrets and operator files (NEVER commit)
# Don't ignore the deploy/secrets/ directory itself — only its contents — so the
# README explaining what goes in there stays tracked.
secrets/
!deploy/secrets/
deploy/secrets/*
!deploy/secrets/README.md
*.pem
*.key
.workstream-admin.toml
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Claude Code per-user config and hook artifacts. Team-wide hooks (if any) go in
# .claude/settings.json which IS committed; the local override and hook scripts
# are personal.
.claude/settings.local.json
.claude/hooks/
.claude/last-rebuild.log

# Local-only seed migrations (contain operator's MCP URL token + GitHub Project
# V2 node ids tied to a specific org). Docker build still copies them into the
# image because docker doesn't honor .gitignore, so the seeds run as normal —
# they just don't leak into git history.
deploy/migrations/0007_seed_crbrl_ai.sql

# Coverage
coverage/
*.coverage
*.coveragexml

# Logs
*.log
logs/
