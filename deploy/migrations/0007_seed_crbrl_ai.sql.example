-- TEMPLATE — copy to 0007_seed_<your-slug>.sql, fill in the bracketed values, and
-- DROP THE .example suffix so the SqlMigrationRunner picks it up. The real file is
-- gitignored (see deploy/migrations/0007_seed_*.sql in .gitignore).
--
-- Purpose: declarative seed for a single project deployment. Re-creating the DB
-- (docker compose down -v && up) replays this migration and lands you with:
--   * one operator user (Claude MCP URL preserved)
--   * one project bound to a real GitHub Projects V2 board
--   * one development plan
--   * five demo tasks pre-enqueued to the board so cards appear in Backlog after
--     the BoardSyncWorker drains
--
-- Prerequisites before running:
--   1. A GitHub App with Organization → Projects: Read & write installed on the org
--      (see docs/github-setup.md).
--   2. The App's private key dropped into deploy/secrets/gh_app_key.pem.
--   3. WORKSTREAM_GH_APP_ID and WORKSTREAM_GH_INSTALLATION_ID in deploy/.env.
--   4. The board's Status field options resolved via /admin/boards/discover (this
--      returns the PVT_, PVTSSF_, and PVTSO_ ids below).
--   5. The operator's MCP URL token already generated via POST /admin/users (or
--      replaced by a random 256-bit URL-safe base64 string).
--   6. Slack: deploy/secrets/slack-demo file containing the bot token, declared
--      as the `slack_demo` docker-compose secret.

BEGIN;

-- ------------------------------------------------------------
-- Organization
-- ------------------------------------------------------------
INSERT INTO organizations (id, name) VALUES
    ('11111111-1111-1111-1111-111111111111', '<YOUR-ORG-DISPLAY-NAME>')
ON CONFLICT (id) DO NOTHING;

-- ------------------------------------------------------------
-- Operator. Use the same mcp_url_token that's already in your Claude config so
-- the URL keeps working after a re-seed. Generate a fresh one with
--   openssl rand -base64 32 | tr -d '=' | tr '+/' '-_'
-- if this is a clean install.
-- ------------------------------------------------------------
INSERT INTO users (
    id, github_username, display_name, mcp_url_token, actor_type,
    is_admin, can_override_verdict, can_archive_plan, can_mark_needs_human_review
) VALUES (
    '22222222-2222-2222-2222-222222222222',
    '<github-username>',
    '<Display Name>',
    '<INSERT-256-BIT-URL-SAFE-BASE64-TOKEN>',
    'human',
    true, true, true, true
)
ON CONFLICT (id) DO UPDATE SET
    github_username     = EXCLUDED.github_username,
    display_name        = EXCLUDED.display_name,
    mcp_url_token       = EXCLUDED.mcp_url_token,
    actor_type          = EXCLUDED.actor_type,
    is_admin            = EXCLUDED.is_admin,
    can_override_verdict= EXCLUDED.can_override_verdict;

-- ------------------------------------------------------------
-- Project
-- ------------------------------------------------------------
INSERT INTO projects (id, organization_id, slug, display_name, description)
VALUES (
    '33333333-3333-3333-3333-333333333333',
    '11111111-1111-1111-1111-111111111111',
    '<project-slug>',
    '<Project Display Name>',
    '<One-sentence project description.>'
)
ON CONFLICT (id) DO NOTHING;

-- ------------------------------------------------------------
-- Project board (Projects V2). Resolve all node ids in one call:
--   POST /admin/boards/discover { "org": "<ORG>", "projectNumber": <N> }
-- ------------------------------------------------------------
INSERT INTO project_boards (
    id, project_id, github_project_v2_node_id, github_project_number, github_owner,
    display_name, status_field_node_id,
    status_option_backlog, status_option_in_progress, status_option_review, status_option_done
) VALUES (
    '44444444-4444-4444-4444-444444444444',
    '33333333-3333-3333-3333-333333333333',
    '<PVT_node-id-from-discover>',
    <project-number>,
    '<github-org-slug>',
    '<Board display name>',
    '<PVTSSF_status-field-node-id>',
    '<PVTSO-option-id-for-Backlog>',
    '<PVTSO-option-id-for-In-Progress>',
    '<PVTSO-option-id-for-Review>',
    '<PVTSO-option-id-for-Done>'
)
ON CONFLICT (id) DO NOTHING;

-- ------------------------------------------------------------
-- Slack workspace + channel for this project. bot_token_secret_ref points at the
-- docker secret mount (file:///run/secrets/<secret-name>). The secret file
-- contains the Slack Bot User OAuth Token (xoxb-…).
-- ------------------------------------------------------------
INSERT INTO project_slack (project_id, workspace_id, bot_token_secret_ref, default_channel_id)
VALUES (
    '33333333-3333-3333-3333-333333333333',
    '<slack-workspace-id-or-subdomain>',
    'file:///run/secrets/<your-slack-secret-name>',
    '<C-channel-id>'
)
ON CONFLICT (project_id) DO NOTHING;

-- ------------------------------------------------------------
-- Plan: development, active, bound to the board.
-- ------------------------------------------------------------
INSERT INTO plans (
    id, project_id, plan_type_id, name, objective, status,
    primary_board_id, created_by_actor_id, activated_at
) VALUES (
    '55555555-5555-5555-5555-555555555555',
    '33333333-3333-3333-3333-333333333333',
    'development',
    '<Plan name, e.g. Phase 1>',
    '<Plan objective, one sentence>',
    'active',
    '44444444-4444-4444-4444-444444444444',
    '22222222-2222-2222-2222-222222222222',
    now()
)
ON CONFLICT (id) DO NOTHING;

-- ------------------------------------------------------------
-- Demo tasks. Edit the (external_key, title, description, priority) tuples to
-- whatever fits your project. Five rows is just a convenient size for a smoke
-- test of the plug-and-play developer flow.
-- ------------------------------------------------------------
INSERT INTO tasks (id, plan_id, external_key, title, description, priority, status) VALUES
(
    'aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa',
    '55555555-5555-5555-5555-555555555555',
    'T-001',
    '<Task 1 title>',
    '<Task 1 short description (1–2 sentences).>',
    5,
    'pending'
),
(
    'aaaaaaaa-2222-2222-2222-aaaaaaaaaaaa',
    '55555555-5555-5555-5555-555555555555',
    'T-002',
    '<Task 2 title>',
    '<Task 2 short description.>',
    4,
    'pending'
),
(
    'aaaaaaaa-3333-3333-3333-aaaaaaaaaaaa',
    '55555555-5555-5555-5555-555555555555',
    'T-003',
    '<Task 3 title>',
    '<Task 3 short description.>',
    3,
    'pending'
),
(
    'aaaaaaaa-4444-4444-4444-aaaaaaaaaaaa',
    '55555555-5555-5555-5555-555555555555',
    'T-004',
    '<Task 4 title>',
    '<Task 4 short description.>',
    2,
    'pending'
),
(
    'aaaaaaaa-5555-5555-5555-aaaaaaaaaaaa',
    '55555555-5555-5555-5555-555555555555',
    'T-005',
    '<Task 5 title>',
    '<Task 5 short description.>',
    1,
    'pending'
)
ON CONFLICT (id) DO NOTHING;

-- ------------------------------------------------------------
-- Pre-enqueue board syncs so the cards land on the GitHub board automatically
-- on first BoardSyncWorker drain. Idempotent — skips tasks already enqueued.
-- ------------------------------------------------------------
INSERT INTO board_sync_log (task_id, board_id, target_column, target_status)
SELECT t.id,
       '44444444-4444-4444-4444-444444444444',
       'backlog',
       'pending'
FROM tasks t
WHERE t.plan_id = '55555555-5555-5555-5555-555555555555'
  AND NOT EXISTS (
      SELECT 1 FROM board_sync_log b
      WHERE b.task_id = t.id AND b.board_id = '44444444-4444-4444-4444-444444444444'
  );

INSERT INTO __migrations (version) VALUES ('0007_seed_<your-slug>')
ON CONFLICT (version) DO NOTHING;

COMMIT;
