# Local reproduction of the Glama build (https://glama.ai/mcp/servers), for testing only.
#
# Glama does not read this file. It builds from its own form: a locked debian:trixie-slim base
# with Node.js and mcp-proxy, a git clone of this repository, then the "build steps", then
# `mcp-proxy -- <CMD arguments>`. mcp-proxy runs the server over stdio and exposes it as
# Streamable HTTP for Glama's introspection (initialize, tools/list).
#
# Values to enter in the Glama form (single-line JSON):
#   Build steps:    ["curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh", "bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/local/dotnet", "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 /usr/local/dotnet/dotnet publish src/Workstream.Api/Workstream.Api.csproj -c Release -o /app/out"]
#   CMD arguments:  ["/usr/local/dotnet/dotnet", "/app/out/Workstream.Api.dll", "--stdio"]
#   Environment:    none required (no database means discovery mode)
#
#   docker build -f deploy/Dockerfile.glama -t workstream-mcp:glama .
#   docker run --rm -p 127.0.0.1:8080:8080 workstream-mcp:glama

FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g mcp-proxy@6.4.3 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Glama clones the repository here; locally we copy the working tree instead.
COPY . .
RUN (curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh) \
 && (bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/local/dotnet) \
 && (DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 /usr/local/dotnet/dotnet publish src/Workstream.Api/Workstream.Api.csproj -c Release -o /app/out)
CMD ["mcp-proxy", "--", "/usr/local/dotnet/dotnet", "/app/out/Workstream.Api.dll", "--stdio"]
