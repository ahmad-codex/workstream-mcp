# syntax=docker/dockerfile:1.7
# Workstream audit-dispatcher container.
#
# Runs the same .NET app as the api image but with WORKSTREAM_ROLE=dispatcher, so only
# the AuditDispatchWorker is active (no HTTP surface, no MCP tools, no migrations, no
# Slack/GitHub workers). Unlike the lean api image this one additionally carries git,
# tmux and the Claude Code CLI — the dispatch script clones each project's repo and
# launches its audit orchestrator in an attachable tmux session.
#
# A Debian (glibc) runtime is used rather than alpine for Claude Code / Node compatibility.

FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy csproj files first for layer caching on dependency restores.
COPY global.json NuGet.config Directory.Build.props Directory.Packages.props ./
COPY src/Workstream.Api/Workstream.Api.csproj                   src/Workstream.Api/
COPY src/Workstream.Core/Workstream.Core.csproj                 src/Workstream.Core/
COPY src/Workstream.Data/Workstream.Data.csproj                 src/Workstream.Data/
COPY src/Workstream.GitHub/Workstream.GitHub.csproj             src/Workstream.GitHub/
COPY src/Workstream.Slack/Workstream.Slack.csproj               src/Workstream.Slack/
COPY src/Workstream.Telemetry/Workstream.Telemetry.csproj       src/Workstream.Telemetry/
COPY src/Workstream.Mcp/Workstream.Mcp.csproj                   src/Workstream.Mcp/
RUN dotnet restore src/Workstream.Api/Workstream.Api.csproj

# Framework-dependent publish (no RID) — portable IL, runs on the Debian runtime below.
COPY src/ src/
RUN dotnet publish src/Workstream.Api/Workstream.Api.csproj -c Release -o /publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# git + tmux to check out repos and host attachable audit sessions; Node for the Claude
# Code CLI the dispatch script invokes.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git tmux curl ca-certificates \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs openssh-client \
 && npm install -g @anthropic-ai/claude-code ssh-mcp \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Non-root user for the audit runs: Claude Code refuses --dangerously-skip-permissions
# under root. The .NET worker still runs as root (it must read root:root Docker secrets);
# the dispatch script drops to this user, via runuser, only for the `claude` process.
# safe.directory='*' lets root run git inside the auditor-owned repo checkouts.
RUN useradd --create-home auditor \
 && mkdir -p /home/auditor/.claude \
 && chown -R auditor:auditor /home/auditor \
 && git config --system --add safe.directory '*'

COPY --from=build /publish/ ./
COPY deploy/audit-dispatch.sh /app/audit-dispatch.sh
RUN chmod +x /app/audit-dispatch.sh

ENV WORKSTREAM_ROLE=dispatcher \
    WORKSTREAM_AUDIT_DISPATCH_ENABLED=true \
    WORKSTREAM_AUDIT_DISPATCH_SCRIPT=/app/audit-dispatch.sh \
    WS_REPOS_DIR=/srv/audit-repos \
    ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
ENTRYPOINT ["dotnet", "Workstream.Api.dll"]
